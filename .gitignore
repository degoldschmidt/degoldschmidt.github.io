.DS_Store

# Jekyll
_site/
.jekyll-cache/
.jekyll-metadata
vendor/
Gemfile.lock
.bundle/

# Poster PDFs stay local. GitHub Pages has no access control, so anything
# tracked here is public and permanently archived. Share via email or Zenodo.
posters/
HANDOFF.md

# Scratch preview page for the gallery. Builds locally so it can be looked at
# on the real site; never committed, so a push cannot publish it. GitHub Pages
# has no access control and an unlinked URL is not private, so "unlinked" is
# not a safeguard — "not in the repo" is.
gallery-preview.html

# Figure sources and the clip-art used to build them. Only the exported
# derivative belongs in the repo — everything Jekyll finds under images/ is
# published, and these are ~4.5 MB of working files that nothing references.
# Untracked is not enough on its own: `git add -A` would sweep them in, which
# is how the poster PDF got committed.
images/portfolios/**/fig2_project_objectives*
images/portfolios/**/*laser*icon*.png
images/portfolios/**/*Laser*icon*.png

# Source video. Only web derivatives belong in the repo, under assets/media/ —
# see its README. A source clip is tens of MB and would live in git history
# forever, which is how this repo reached 1.18 GB the first time.
# Jekyll needs its own `exclude:` entry for this; .gitignore does not affect it.
videos/
