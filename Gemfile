source "https://rubygems.org"

# Mirrors the gem set GitHub Pages pins server-side. Pages ignores this file
# entirely — it exists only so `bundle exec jekyll serve` reproduces the real
# build locally.
gem "github-pages", group: :jekyll_plugins

# Ruby >= 3.0 dropped webrick from stdlib; Jekyll 3 won't boot without it.
gem "webrick", "~> 1.8"
